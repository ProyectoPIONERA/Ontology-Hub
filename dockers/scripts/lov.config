ELASTICSEARCH_CLUSTER=elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_INDEX_NAME=lov
# Optional aliases: ELASTIC_SEARCH_HOST, ELASTIC_SEARCH_CLUSTER, ELASTIC_SEARCH_INDEX_NAME
# Credentials (defaults: user elastic, password OntologyHub2026 if omitted)
ELASTIC_SEARCH_USER=elastic
ELASTIC_SEARCH_PASSWORD=OntologyHub2026
MONGO_DB_HOST=mongodb
MONGO_DB_PORT=27017
MONGO_DB_INSTANCE=lov
LANGUAGES_FILE_PATH=/app/scripts/languages.rdf
LOV_DATASET_URI=http://lov_server:3333/dataset/lov
LOV_ENDPOINT=http://lov_server:8180/openrdf-sesame/repositories/lov
LOV_NQ_FILE_PATH=/app/public/lov.nq
# Empty or fresh directory for TDB bulk load (index-lov); reuse only after successful runs
LOV_TMP_DUMP_PATH=/app/tdb-tmp
LOV_RDF_FILE_PATH=/app/scripts/lov.rdf
LOV_N3_FILE_PATH=/app/public/lov.n3
METRICS_FILE_PATH=/app/scripts/lov_metrics.n3
VERSIONS_DIR_PATH=/app/versions
VERSIONS_TEMP_PATH=/app/versions/temp

SCRIPTS_PATH=/app/scripts
PATTERN_PATHS=/app/Patterns/Patrones
