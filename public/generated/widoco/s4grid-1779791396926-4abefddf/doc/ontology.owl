        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasInputObjectType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">This class specifies that the whole instance is going to be modified</rdfs:comment>
        <rdfs:label xml:lang="en">Set Operation Obis Input</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/SetOperationObjectInput -->


