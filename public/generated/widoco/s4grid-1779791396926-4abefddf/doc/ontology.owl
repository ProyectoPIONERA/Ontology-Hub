        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4grid/SelectiveAccess"/>
        <rdfs:comment xml:lang="en">In the case of a get service of a profile generic class a selective access can be specified. This indicates the range of entries to be retrieved from the profile generic class</rdfs:comment>
        <rdfs:label xml:lang="en">Entry Descriptor</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/Firmware -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/Firmware">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasFirmwareVersion"/>
