            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasFridayProfile"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasMondayProfile"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasSaturdayProfile"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasSundayProfile"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasThursdayProfile"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasTuesdayProfile"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasWednesdayProfile"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasSeasonProfileName"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasSeasonStart"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">[COSEM] This class represents a season which is defined by its starting date and a specific day profile to be executed</rdfs:comment>
        <rdfs:label xml:lang="en">Season Profile</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/SelectiveAccess -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/SelectiveAccess">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/oneM2M#OperationInput"/>
        <rdfs:comment xml:lang="en">The get operations property-related services typically reference the entire property. However, in the case of certain properties, selective access to only part of the property may be provided</rdfs:comment>
        <rdfs:label xml:lang="en">Selective Access</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/SetOperation -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/SetOperation">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Operation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/core/hasInput"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">This class is the means of a set service to communicate in a procedure-type manner over the network (i.e. transmit data to/from other devices). It is the –machine interpretable- exposure of a –human understandable- Command to a network</rdfs:comment>
        <rdfs:label xml:lang="en">Set Operation</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/SetOperationDataInput -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/SetOperationDataInput">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4grid/CosemOperationInput"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasInputDataType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/obtainInputForProperty"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">This class specifies that just the range of a datatype property of the instance is going to be modified</rdfs:comment>
        <rdfs:label xml:lang="en">Set Operation Data Input</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/SetOperationObisInput -->


