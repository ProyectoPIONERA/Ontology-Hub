            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasVendorId"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">[COSEM] This class holds identification information related to administration and maintenance of meters. They are not communication parameters but allow the device management</rdfs:comment>
        <rdfs:label xml:lang="en">Firmware</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/GetOperation -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/GetOperation">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Operation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/core/hasInput"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/core/hasOutput"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">This class is the means of a get service to communicate in a procedure-type manner over the network (i.e. transmit data to/from other devices). It is the –machine interpretable- exposure of a –human understandable- Command to a network</rdfs:comment>
        <rdfs:label xml:lang="en">Get Operation</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/GetOperationDataOutput -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/GetOperationDataOutput">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4grid/GetOperationOutput"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasOutputDataType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">This class specifies that the output of a get operation is going to be a datatype</rdfs:comment>
        <rdfs:label xml:lang="en">Get Operation Data Output</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/GetOperationObjectOutput -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/GetOperationObjectOutput">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4grid/GetOperationOutput"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasOutputObjectType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">This class specifies that the output of a get operation is going to be a class</rdfs:comment>
        <rdfs:label xml:lang="en">Get Operation Object Output</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/GetOperationOutput -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/GetOperationOutput">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/oneM2M#OperationOutput"/>
        <rdfs:comment xml:lang="en">This class specifies the output of a get operation, which can be either a class or a datatype</rdfs:comment>
        <rdfs:label xml:lang="en">Get Operation Output</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/GetOperationPropertyInput -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/GetOperationPropertyInput">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4grid/CosemOperationInput"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/obtainInputForProperty"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">This class specifies the object/datatype property of an instance from which data is going to be retrieved by indicating the name of the object/datatype property</rdfs:comment>
        <rdfs:label xml:lang="en">Get Operation Property Input</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/GetService -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/GetService">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Service"/>
        <rdfs:comment xml:lang="en">This class is a representation of a get function to a network that makes the function discoverable, registerable, remotely controllable by other devices in the network</rdfs:comment>
        <rdfs:label xml:lang="en">Get Service</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/GridMeter -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/GridMeter">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Meter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/core/hasPropertyValue"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://saref.etsi.org/core/isValueOfProperty"/>
                        <owl:allValuesFrom rdf:resource="https://saref.etsi.org/saref4grid/MeterProperty"/>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Metering device that remotely records real electricity consumption. This device allows to control all the information regarding consumption for any time range, automatically and remotely</rdfs:comment>
        <rdfs:label xml:lang="en">Meter</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/MeterProperty -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/MeterProperty">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Property"/>
        <rdfs:comment xml:lang="en">Class to group those properties related to electric grid meters</rdfs:comment>
        <rdfs:label xml:lang="en">Meter Property</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/NetworkInterface -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/NetworkInterface">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasMACAddress"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">[COSEM] This class holds the MAC address of the physical device (or, more generally, of a device or software). There shall be an instance of this class for each network interface of the physical device</rdfs:comment>
        <rdfs:label xml:lang="en">Network Interface</rdfs:label>
    </owl:Class>
    


