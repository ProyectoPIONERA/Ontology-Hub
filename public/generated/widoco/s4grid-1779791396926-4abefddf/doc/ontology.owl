    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/source -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#time -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#time"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://schema.org/affiliation -->


    <owl:ObjectProperty rdf:about="http://schema.org/affiliation"/>
    


    <!-- http://www.owl-ontologies.com/oneM2M#hasService -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/oneM2M#hasService">
        <rdfs:isDefinedBy rdf:resource="https://git.onem2m.org/MAS/BaseOntology"/>
        <rdfs:label xml:lang="en">has service</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/executesScript -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/executesScript">
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/Script"/>
        <rdfs:comment xml:lang="en">[COSEM] Defines the script to be executed</rdfs:comment>
        <rdfs:label xml:lang="en">executes script</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasActiveSeasonProfile -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasActiveSeasonProfile">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/ActivityCalendar"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/SeasonProfile"/>
        <rdfs:comment xml:lang="en">[COSEM] Contains a list of active season profiles. These season profiles form an active calendar</rdfs:comment>
        <rdfs:label xml:lang="en">has active season profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasActivityCalendar -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasActivityCalendar">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/GridMeter"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/ActivityCalendar"/>
        <rdfs:comment xml:lang="en">The activity calendar of a meter</rdfs:comment>
        <rdfs:label xml:lang="en">has activity calendar</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasClock -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasClock">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/GridMeter"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/Clock"/>
        <rdfs:comment xml:lang="en">The clock of the meter</rdfs:comment>
        <rdfs:label xml:lang="en">has clock</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasDayProfile -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasDayProfile">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/SeasonProfile"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/DayProfile"/>
        <rdfs:comment xml:lang="en">[COSEM] Day profile for every day of the week of a season</rdfs:comment>
        <rdfs:label xml:lang="en">has day profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasDaySchedule -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasDaySchedule">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/DayProfile"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/DaySchedule"/>
        <rdfs:comment xml:lang="en">The day schedule of a day profile</rdfs:comment>
        <rdfs:label xml:lang="en">has day schedule</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasFirmware -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasFirmware">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/GridMeter"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/Firmware"/>
        <rdfs:comment xml:lang="en">The firmware of the meter</rdfs:comment>
        <rdfs:label xml:lang="en">has firmware</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasFridayProfile -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasFridayProfile">
        <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4grid/hasDayProfile"/>
        <rdfs:comment xml:lang="en">It defines the day profile valid each Friday of the season</rdfs:comment>
        <rdfs:label xml:lang="en">has friday profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasMondayProfile -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasMondayProfile">
        <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4grid/hasDayProfile"/>
        <rdfs:comment xml:lang="en">It defines the day profile valid each Monday of the season</rdfs:comment>
        <rdfs:label xml:lang="en">has monday profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasNetworkInterface -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasNetworkInterface">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/GridMeter"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/NetworkInterface"/>
        <rdfs:comment xml:lang="en">The network interface of the meter</rdfs:comment>
        <rdfs:label xml:lang="en">has network interface</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasPassiveSeasonProfile -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasPassiveSeasonProfile">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/ActivityCalendar"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/SeasonProfile"/>
        <rdfs:comment xml:lang="en">[COSEM] Contains a list of passive season profiles. These season profiles form a passive calendar</rdfs:comment>
        <rdfs:label xml:lang="en">has passive season profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasProfileGeneric -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasProfileGeneric">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/GridMeter"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/ProfileGeneric"/>
        <rdfs:comment xml:lang="en">The profile generic of a meter</rdfs:comment>
        <rdfs:label xml:lang="en">has profile generic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasSaturdayProfile -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasSaturdayProfile">
        <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4grid/hasDayProfile"/>
        <rdfs:comment xml:lang="en">It defines the day profile valid each Saturday of the season</rdfs:comment>
        <rdfs:label xml:lang="en">has saturday profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasScriptTable -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasScriptTable">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/GridMeter"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/ScriptTable"/>
        <rdfs:comment xml:lang="en">The script table of a meter</rdfs:comment>
        <rdfs:label xml:lang="en">has script table</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasSelectiveAccess -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasSelectiveAccess">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/GetOperation"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/SelectiveAccess"/>
        <rdfs:comment xml:lang="en">The selective access of a profile generic get service</rdfs:comment>
        <rdfs:label xml:lang="en">has selective access</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasSingleScheduledAction -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasSingleScheduledAction">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/GridMeter"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/SingleScheduledAction"/>
        <rdfs:comment xml:lang="en">The single scheduled action of a meter</rdfs:comment>
        <rdfs:label xml:lang="en">has single scheduled action</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasSpecialDayProfile -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasSpecialDayProfile">
        <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4grid/hasDayProfile"/>
        <rdfs:comment xml:lang="en">It defines when there is a festivity and therefore a normal day behaves as a special date</rdfs:comment>
        <rdfs:label xml:lang="en">has special day profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasSundayProfile -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasSundayProfile">
        <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4grid/hasDayProfile"/>
        <rdfs:comment xml:lang="en">It defines the day profile valid each Sunday of the season</rdfs:comment>
        <rdfs:label xml:lang="en">has sunday profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasThursdayProfile -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasThursdayProfile">
        <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4grid/hasDayProfile"/>
        <rdfs:comment xml:lang="en">It defines the day profile valid each Thursday of the season</rdfs:comment>
        <rdfs:label xml:lang="en">has thursday profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasTuesdayProfile -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasTuesdayProfile">
        <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4grid/hasDayProfile"/>
        <rdfs:comment xml:lang="en">It defines the day profile valid each Tuesday of the season</rdfs:comment>
        <rdfs:label xml:lang="en">has tuesday profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasWednesdayProfile -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/hasWednesdayProfile">
        <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4grid/hasDayProfile"/>
        <rdfs:comment xml:lang="en">It defines the day profile valid each Wednesday of the season</rdfs:comment>
        <rdfs:label xml:lang="en">has wednesday profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/relatedClock -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/relatedClock">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/ProfileGeneric"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/Clock"/>
        <rdfs:comment xml:lang="en">The clock that is captured by a profile generic</rdfs:comment>
        <rdfs:label xml:lang="en">related clock</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/relatedObservation -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/relatedObservation">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/ProfileGeneric"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/core/Observation"/>
        <rdfs:comment xml:lang="en">The observation that is captured by a profile generic</rdfs:comment>
        <rdfs:label xml:lang="en">related observation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/relatedPropertyValue -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/relatedPropertyValue">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/ProfileGeneric"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/core/PropertyValue"/>
        <rdfs:comment xml:lang="en">The property value that is captured by a profile generic</rdfs:comment>
        <rdfs:label xml:lang="en">related property value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4grid/storesScript -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4grid/storesScript">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/ScriptTable"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/Script"/>
        <rdfs:comment xml:lang="en">[COSEM] Specifies the different scripts which are stored in a script table</rdfs:comment>
        <rdfs:label xml:lang="en">stores script</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://schema.org/familyName -->


    <owl:DatatypeProperty rdf:about="http://schema.org/familyName"/>
    


    <!-- http://schema.org/givenName -->


    <owl:DatatypeProperty rdf:about="http://schema.org/givenName"/>
    


    <!-- http://schema.org/name -->


    <owl:DatatypeProperty rdf:about="http://schema.org/name"/>
    


    <!-- https://saref.etsi.org/saref4grid/hasActionValue -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasActionValue">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/SimpleActionOperationInput"/>
        <rdfs:comment xml:lang="en">It specifies the input of a method from the instance (COSEM object) of a class. The value of this property conforms to a simple type (not a structure)</rdfs:comment>
        <rdfs:label xml:lang="en">has action value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasActivatePassiveCalendarTime -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasActivatePassiveCalendarTime">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/ActivityCalendar"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">[COSEM] Defines the time when the passive calendar will be activated</rdfs:comment>
        <rdfs:label xml:lang="en">has activate passive calendar time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasCalendarNameActive -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasCalendarNameActive">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/ActivityCalendar"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">[COSEM] Used defined name identifying the passive calendar. Typically contains an identifier of the active calendar (currently active), which is descriptive to the set of scripts activated by the object</rdfs:comment>
        <rdfs:label xml:lang="en">has calendar name active</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasCalendarNamePassive -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasCalendarNamePassive">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/ActivityCalendar"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">[COSEM] User defined name identifying the passive calendar. Typically contains an identifier of the passive calendar (will be activated), which is descriptive to the set of scripts activated by the object</rdfs:comment>
        <rdfs:label xml:lang="en">has calendar name passive</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasCapturePeriod -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasCapturePeriod">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/ProfileGeneric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">[COSEM] The capturing period of a profile generic in seconds. If its value is 0, then there is not automatic capturing; capturing is triggered externally or through capture events occur asynchronously. If its value is greater than 0, then automatic capturing is assumed</rdfs:comment>
        <rdfs:label xml:lang="en">has capture period</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasClockBase -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasClockBase">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Clock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">[COSEM] Defines where the basic timing information comes from: (0) not defined, (1) internal crystal, (2) mains frequency 50 Hz, (3) mains frequency 60 Hz, (4) GPS (global positioning system), (5) radio controlled</rdfs:comment>
        <rdfs:label xml:lang="en">has clock base</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasControlMode -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasControlMode">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/BreakerState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">[COSEM] Configures the behaviour of the disconnect control object for all triggers, i.e. the possible state transitions</rdfs:comment>
        <rdfs:label xml:lang="en">has control mode</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasControlState -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasControlState">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/BreakerState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Shows the internal state of the disconnect control object: (0) Disconnected, (1) Connected, (2) Ready for reconnection</rdfs:comment>
        <rdfs:label xml:lang="en">has control state</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasDayId -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasDayId">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/SpecialDayEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">It defines the unique identifier of a day</rdfs:comment>
        <rdfs:label xml:lang="en">has day id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasDaylightSavingsBegin -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasDaylightSavingsBegin">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Clock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">[COSEM] Defines the local switch date and time when the local time starts to deviate from the normal time</rdfs:comment>
        <rdfs:label xml:lang="en">has daylight savings begin</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasDaylightSavingsDeviation -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasDaylightSavingsDeviation">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Clock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">[COSEM] Contains the number of minutes by which the deviation in generalized time shall be corrected at daylight savings begin</rdfs:comment>
        <rdfs:label xml:lang="en">has daylight savings deviation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasDaylightSavingsEnabled -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasDaylightSavingsEnabled">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Clock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">[COSEM] Enable and disable the daylight savings time feature</rdfs:comment>
        <rdfs:label xml:lang="en">has daylight savings enabled</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasDaylightSavingsEnd -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasDaylightSavingsEnd">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Clock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">[COSEM] Defines the local switch date and time when the local time ends to deviate from the local normal time</rdfs:comment>
        <rdfs:label xml:lang="en">has daylight savings end</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasExecutionTime -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasExecutionTime">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/SingleScheduledAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">[COSEM] Specifies the time and the date when the script is executed</rdfs:comment>
        <rdfs:label xml:lang="en">has execution time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasFirmwareVersion -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasFirmwareVersion">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Firmware"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">[COSEM] Textual description of the firmware version running on the device</rdfs:comment>
        <rdfs:label xml:lang="en">has firmware version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasIndex -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasIndex">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/SpecialDayEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
        <rdfs:comment xml:lang="en">It defines the index of the special day</rdfs:comment>
        <rdfs:label xml:lang="en">has index</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasInputDataType -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasInputDataType">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/SetOperationDataInput"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It identifies the type of the attribute of an instance (COSEM object) of a class from which the data is going to be obtained. The value of this property conforms to the range of a datatype property of SAREF4GRID</rdfs:comment>
        <rdfs:label xml:lang="en">has input data type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasInputObjectType -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasInputObjectType">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It identifies the type of the attribute of an instance (COSEM object) of a class from which the data is going to be obtained. The value of this property conforms to the range of an object property of SAREF4GRID</rdfs:comment>
        <rdfs:label xml:lang="en">has input object type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasMACAddress -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasMACAddress">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/NetworkInterface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">[COSEM] Holds the MAC address</rdfs:comment>
        <rdfs:label xml:lang="en">has m a c address</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasObis -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasObis">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">[COSEM] It identifies the instance (COSEM object) of a class. The value of this property conforms to OBIS. OBject Identification System (OBIS) provides a unique identifier for all data within the metering equipment, including not only measurement values, but also abstract values used for configuration or obtaining information about the behaviour of the metering equipment</rdfs:comment>
        <rdfs:label xml:lang="en">has obis</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasOutputDataType -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasOutputDataType">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/GetOperationDataOutput"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It identifies the type of the attribute of an instance (COSEM object) of a class from which the data is going to be obtained. The value of this property conforms to the range of a datatype property of SAREF4GRID</rdfs:comment>
        <rdfs:label xml:lang="en">has output data type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasOutputObjectType -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasOutputObjectType">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/GetOperationObjectOutput"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It identifies the type of the attribute of an instance (COSEM object) of a class from which the data is going to be obtained. The value of this property conforms to the range of an object property of SAREF4GRID</rdfs:comment>
        <rdfs:label xml:lang="en">has output object type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasOutputState -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasOutputState">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/BreakerState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">[COSEM] Shows the actual physical state of the device connection to the supply: (True) Connected, (False) Disconnected</rdfs:comment>
        <rdfs:label xml:lang="en">has output state</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasPresetTime -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasPresetTime">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/PresetAdjustingTime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">It pre-sets the clock time to a new value</rdfs:comment>
        <rdfs:label xml:lang="en">has preset time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasProductId -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasProductId">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Firmware"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
        <rdfs:comment xml:lang="en">[COSEM] Vendor-assigned unique identifier for the specific product</rdfs:comment>
        <rdfs:label xml:lang="en">has product id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasSeasonProfileName -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasSeasonProfileName">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/SeasonProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">[COSEM] User defined name identifying the current season profile</rdfs:comment>
        <rdfs:label xml:lang="en">has season profile name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasSeasonStart -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasSeasonStart">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/ActivityCalendar"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">[COSEM] Starting time of the season profile. The current season profile is terminated by the starting time of the next season</rdfs:comment>
        <rdfs:label xml:lang="en">has season start</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasSpecialDate -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasSpecialDate">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/SpecialDayEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">It defines the date at which a normal day is considered a special date</rdfs:comment>
        <rdfs:label xml:lang="en">has special date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasSpecialDayDate -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasSpecialDayDate">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/SpecialDayProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Dates at which a normal day is considered a special date (i.e., Christmas)</rdfs:comment>
        <rdfs:label xml:lang="en">has special day date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasStartTime -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasStartTime">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/DaySchedule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#time"/>
        <rdfs:comment xml:lang="en">[COSEM] Time when the script is going to be executed</rdfs:comment>
        <rdfs:label xml:lang="en">has start time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasStatus -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasStatus">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Clock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">[COSEM] Status of the clock</rdfs:comment>
        <rdfs:label xml:lang="en">has status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasTime -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasTime">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Clock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">[COSEM] Meter’s local date and time</rdfs:comment>
        <rdfs:label xml:lang="en">has time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasTimeZone -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasTimeZone">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Clock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#long"/>
        <rdfs:comment xml:lang="en">[COSEM] The deviation of local, normal time to UTC in minutes. The value depends on the geographical location of the meter</rdfs:comment>
        <rdfs:label xml:lang="en">has time zone</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasValidityIntervalEnd -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasValidityIntervalEnd">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/PresetAdjustingTime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">It defines the end of a validity interval within which the new time can be activated</rdfs:comment>
        <rdfs:label xml:lang="en">has validity interval end</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasValidityIntervalStart -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasValidityIntervalStart">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/PresetAdjustingTime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">It defines the start of a validity interval within which the new time can be activated</rdfs:comment>
        <rdfs:label xml:lang="en">has validity interval start</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/hasVendorId -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/hasVendorId">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Firmware"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
        <rdfs:comment xml:lang="en">[COSEM] Unique vendor identifier assigned by the PRIME Alliance</rdfs:comment>
        <rdfs:label xml:lang="en">has vendor id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/obtainFromEntry -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/obtainFromEntry">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/EntryDescriptor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedLong"/>
        <rdfs:comment xml:lang="en">It defines the first entry to be retrieved from a profile generic</rdfs:comment>
        <rdfs:label xml:lang="en">obtain from entry</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/obtainFromValue -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/obtainFromValue">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/RangeDescriptor"/>
        <rdfs:comment xml:lang="en">It restricts the range of entries to be retrieved from a profile generic defining the oldest or smallest entry to retrieve</rdfs:comment>
        <rdfs:label xml:lang="en">obtain from value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/obtainInputForProperty -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/obtainInputForProperty">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It identifies the attribute of an instance (COSEM object) of a class from which the data is going to be obtained. The value of this property conforms to and object property or datatype property of SAREF4GRID</rdfs:comment>
        <rdfs:label xml:lang="en">obtain input for property</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/obtainInputFromObis -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/obtainInputFromObis">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/CosemOperationInput"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It identifies the instance (COSEM object) of a class from which the data is going to be obtained. The value of this property conforms to OBIS</rdfs:comment>
        <rdfs:label xml:lang="en">obtain input from obis</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/obtainToEntry -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/obtainToEntry">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/EntryDescriptor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedLong"/>
        <rdfs:comment xml:lang="en">It defines the last entry to be retrieved from a profile generic</rdfs:comment>
        <rdfs:label xml:lang="en">obtain to entry</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/saref4grid/obtainToValue -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/saref4grid/obtainToValue">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/RangeDescriptor"/>
        <rdfs:comment xml:lang="en">It restricts the range of entries to be retrieved from a profile generic defining the newest or largest entry to retrieve</rdfs:comment>
        <rdfs:label xml:lang="en">obtain to value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://schema.org/Organization -->


    <owl:Class rdf:about="http://schema.org/Organization"/>
    


    <!-- http://schema.org/Person -->


    <owl:Class rdf:about="http://schema.org/Person"/>
    


    <!-- http://www.owl-ontologies.com/oneM2M#Device -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/oneM2M#Device">
        <rdfs:isDefinedBy rdf:resource="https://git.onem2m.org/MAS/BaseOntology"/>
        <rdfs:label xml:lang="en">Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/oneM2M#OperationInput -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/oneM2M#OperationInput">
        <rdfs:isDefinedBy rdf:resource="https://git.onem2m.org/MAS/BaseOntology"/>
        <rdfs:label xml:lang="en">Operation Input</rdfs:label>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/oneM2M#OperationOutput -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/oneM2M#OperationOutput">
        <rdfs:isDefinedBy rdf:resource="https://git.onem2m.org/MAS/BaseOntology"/>
        <rdfs:label xml:lang="en">Operation Output</rdfs:label>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/oneM2M#Service -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/oneM2M#Service">
        <owl:equivalentClass rdf:resource="https://saref.etsi.org/core/Service"/>
        <rdfs:isDefinedBy rdf:resource="https://git.onem2m.org/MAS/BaseOntology"/>
        <rdfs:label xml:lang="en">Service</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/ActionOperation -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/ActionOperation">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Operation"/>
        <rdfs:comment xml:lang="en">This class is the means of an action service to communicate in a procedure-type manner over the network (i.e. transmit data to/from other devices). It is the –machine interpretable- exposure of a –human understandable- Command to a network</rdfs:comment>
        <rdfs:label xml:lang="en">Action Operation</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/ActionService -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/ActionService">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Service"/>
        <rdfs:comment xml:lang="en">This class is a representation of an action function to a network that makes the function discoverable, registerable, remotely controllable by other devices in the network. Actions can be performed over classes that are characterised by an OBIS code</rdfs:comment>
        <rdfs:label xml:lang="en">Action Service</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/ActivityCalendar -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/ActivityCalendar">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasCalendarNameActive"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasCalendarNamePassive"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasActivatePassiveCalendarTime"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">[COSEM] This class allows handling various tariff structures in the meter. This class provides a list of scheduled actions, following the classical way of calendar-based schedules by defining seasons, weeks, etc</rdfs:comment>
        <rdfs:label xml:lang="en">Activity Calendar</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/BreakerState -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/BreakerState">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/State"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasControlMode"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasControlState"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasOutputState"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">[COSEM] This class manages an internal or external disconnect unit of the meter (e.g. electricity breaker, gas valve) in order to connect or disconnect – partly or entirely – the premises of the consumer to / from the supply</rdfs:comment>
        <rdfs:label xml:lang="en">Breaker State</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/Clock -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/Clock">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasClockBase"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasDaylightSavingsBegin"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasDaylightSavingsDeviation"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasDaylightSavingsEnabled"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasDaylightSavingsEnd"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasStatus"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasTime"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasTimeZone"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">[COSEM] This class models the device clock, managing all information related to date and time including deviations of the local time to a generalized time reference (UTC) due to time zones and daylight-saving time schemes</rdfs:comment>
        <rdfs:label xml:lang="en">Clock</rdfs:label>
    </owl:Class>
    


