        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Property"/>
        <rdfs:comment xml:lang="en">Class to group those properties related to the energy and power of power lines</rdfs:comment>
        <rdfs:label xml:lang="en">Energy Power Property</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/EntryDescriptor -->


