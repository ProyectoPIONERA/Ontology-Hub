        <rdfs:label xml:lang="en">Set Service</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/SimpleActionOperationInput -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/SimpleActionOperationInput">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4grid/CosemOperationInput"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasActionValue"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">This class indicates that the parameter needed by the action to operate is simple (i.e., integer, string, etc)</rdfs:comment>
        <rdfs:label xml:lang="en">Simple Action Operation Input</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/SingleScheduledAction -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/SingleScheduledAction">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/executesScript"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">[COSEM] This class allows modelling the execution of periodic actions within a meter; such actions are not necessarily linked to tariffication</rdfs:comment>
        <rdfs:label xml:lang="en">Single Scheduled Action</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4grid/SpecialDayEntry -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4grid/SpecialDayEntry">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4grid/ComplexActionOperationInput"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasDayId"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
